npts 24 24 24                        # num.grid points in xyz
gridfld 1O86_protein.maps.fld        # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N OA SA        # receptor atom types
ligand_types A C HD N NA OA SA       # ligand atom types
receptor 1O86_protein.pdbqt          # macromolecule
gridcenter auto                      # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 1O86_protein.A.map               # atom-specific affinity map
map 1O86_protein.C.map               # atom-specific affinity map
map 1O86_protein.HD.map              # atom-specific affinity map
map 1O86_protein.N.map               # atom-specific affinity map
map 1O86_protein.NA.map              # atom-specific affinity map
map 1O86_protein.OA.map              # atom-specific affinity map
map 1O86_protein.SA.map              # atom-specific affinity map
elecmap 1O86_protein.e.map           # electrostatic potential map
dsolvmap 1O86_protein.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
